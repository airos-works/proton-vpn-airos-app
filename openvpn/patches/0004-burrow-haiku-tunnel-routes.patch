+#if defined(TARGET_HAIKU)
+/*
+ * Program a route through the stack directly. Haiku's route(8) turns any
+ * all-zero destination into the default route and drops its netmask, so
+ * redirect-gateway's 0.0.0.0/1 would become a second default route and the
+ * lower half of the address space would bypass the tunnel.
+ */
+static bool
+haiku_route_ioctl(bool add, const char *iface, int family, const void *network,
+                  const void *netmask, const void *gateway, bool is_default)
+{
+    struct sockaddr_storage destination, mask, via;
+    CLEAR(destination);
+    CLEAR(mask);
+    CLEAR(via);
+    if (family == AF_INET)
+    {
+        struct sockaddr_in *d = (struct sockaddr_in *)&destination;
+        struct sockaddr_in *m = (struct sockaddr_in *)&mask;
+        struct sockaddr_in *g = (struct sockaddr_in *)&via;
+        d->sin_len = m->sin_len = g->sin_len = sizeof(struct sockaddr_in);
+        d->sin_family = m->sin_family = g->sin_family = AF_INET;
+        memcpy(&d->sin_addr, network, sizeof(struct in_addr));
+        memcpy(&m->sin_addr, netmask, sizeof(struct in_addr));
+        if (gateway)
+        {
+            memcpy(&g->sin_addr, gateway, sizeof(struct in_addr));
+        }
+    }
+    else
+    {
+        struct sockaddr_in6 *d = (struct sockaddr_in6 *)&destination;
+        struct sockaddr_in6 *m = (struct sockaddr_in6 *)&mask;
+        struct sockaddr_in6 *g = (struct sockaddr_in6 *)&via;
+        d->sin6_len = m->sin6_len = g->sin6_len = sizeof(struct sockaddr_in6);
+        d->sin6_family = m->sin6_family = g->sin6_family = AF_INET6;
+        memcpy(&d->sin6_addr, network, sizeof(struct in6_addr));
+        memcpy(&m->sin6_addr, netmask, sizeof(struct in6_addr));
+        if (gateway)
+        {
+            memcpy(&g->sin6_addr, gateway, sizeof(struct in6_addr));
+        }
+    }
+
+    struct route_entry route;
+    CLEAR(route);
+    if (is_default)
+    {
+        route.flags = RTF_DEFAULT;
+    }
+    else
+    {
+        route.destination = (struct sockaddr *)&destination;
+        route.mask = (struct sockaddr *)&mask;
+    }
+    if (gateway)
+    {
+        route.gateway = (struct sockaddr *)&via;
+        route.flags |= RTF_GATEWAY;
+    }
+    if (add)
+    {
+        route.flags |= RTF_STATIC;
+    }
+
+    struct ifreq request;
+    CLEAR(request);
+    strncpynt(request.ifr_name, iface, sizeof(request.ifr_name));
+    request.ifr_route = route;
+
+    int fd = socket(family, SOCK_DGRAM, 0);
+    if (fd < 0)
+    {
+        msg(M_WARN | M_ERRNO, "Haiku: cannot open a socket for routes");
+        return false;
+    }
+    bool ok = ioctl(fd, add ? SIOCADDRT : SIOCDELRT, &request, sizeof(request)) == 0;
+    if (!ok)
+    {
+        msg(M_WARN | M_ERRNO, "Haiku: route %s on %s failed", add ? "add" : "delete",
+            iface);
+    }
+    close(fd);
+    return ok;
+}
+
+static bool
+haiku_route_ipv4(bool add, const char *iface, in_addr_t network, in_addr_t netmask,
+                 in_addr_t gateway)
+{
+    struct in_addr n = { htonl(network) };
+    struct in_addr m = { htonl(netmask) };
+    struct in_addr g = { htonl(gateway) };
+    return haiku_route_ioctl(add, iface, AF_INET, &n, &m, gateway ? &g : NULL,
+                             network == 0 && netmask == 0);
+}
+
+static bool
+haiku_route_ipv6(bool add, const char *iface, const struct in6_addr *network,
+                 int netbits, const struct in6_addr *gateway)
+{
+    struct in6_addr mask;
+    CLEAR(mask);
+    for (int i = 0; i < netbits && i < 128; i++)
+    {
+        mask.s6_addr[i / 8] |= 0x80 >> (i % 8);
+    }
+    bool has_gateway = gateway && !IN6_IS_ADDR_UNSPECIFIED(gateway);
+    return haiku_route_ioctl(add, iface, AF_INET6, network, &mask,
+                             has_gateway ? gateway : NULL, netbits == 0);
+}
+
+/*
+ * Haiku names the interface of every route. Routes through the VPN belong
+ * on the tunnel; only routes via the pre-existing default gateway (like the
+ * host route to the server for redirect-gateway) stay on the interface that
+ * reaches that gateway.
+ */
+static const char *
+haiku_route_iface(in_addr_t gateway, const struct tuntap *tt,
+                  const struct route_gateway_info *rgi)
+{
+    if (rgi && (rgi->flags & RGI_IFACE_DEFINED)
+        && (rgi->flags & RGI_ADDR_DEFINED) && gateway == rgi->gateway.addr)
+    {
+        return rgi->iface;
+    }
+    if (tt && tt->actual_name)
+    {
+        return tt->actual_name;
+    }
+    return rgi && (rgi->flags & RGI_IFACE_DEFINED) ? rgi->iface : NULL;
+}
